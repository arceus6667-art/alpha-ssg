# ============================================================
# SkillSet Go EduTech - Environment Variables Example
# Note: Do not store production secrets or plain text passwords here.
# ============================================================

# GEMINI_API_KEY: Injected by runtime for server-side AI endpoints
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: Base URL where the app is hosted
APP_URL="http://localhost:3000"

# NODE_ENV: 'development' or 'production'
NODE_ENV="development"

# PORT: Server port (default: 3000)
PORT=3000

# ADMIN_SESSION_SECRET: (Optional) Secret key used to sign production admin session tokens
ADMIN_SESSION_SECRET="your_secure_session_secret_placeholder"
