# ============================================================
# SkillSet Go EduTech - Environment Variables Configuration
# Production & Centralized Persistence Environment Variables
# Copy to .env for local development: cp .env.example .env
# ============================================================

# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Centralized Database Configuration
# Local SQLite database path is automatically managed at data/ssg.db
# For hosted Postgres / Supabase deployment:
DATABASE_URL="postgresql://postgres:password@db.supabase.co:5432/postgres"

# Admin Authentication & Security
# Used by server-side authentication layer (never exposed to frontend)
ADMIN_EMAIL="admin@skillsetgo.com"
ADMIN_PASSWORD="YourStrongAdminPasswordHere"
ADMIN_SESSION_SECRET="your_cryptographic_random_session_secret_min_32_chars"

# Google Gemini AI Chatbot API
GEMINI_API_KEY="your_google_gemini_api_key_here"

# Real-Time Synchronization Transport
# Options: sse (Server-Sent Events, default) | polling
REALTIME_TRANSPORT=sse

# Student auth (public frontend values only; never use secret/service-role keys)
VITE_SUPABASE_URL=https://tzdxqwetsxktnrcpdnqs.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key
